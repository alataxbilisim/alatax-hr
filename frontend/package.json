{
  "name": "dobedan-hr-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.22.2 <23",
    "pnpm": "9.15.9"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/**\" dev",
    "dev:superadmin": "pnpm --filter @dobedan/superadmin dev",
    "dev:company": "pnpm --filter @dobedan/company dev",
    "dev:portal": "pnpm --filter @dobedan/portal dev",
    "build": "pnpm -r --filter \"./apps/**\" build",
    "build:superadmin": "pnpm --filter @dobedan/superadmin build",
    "build:company": "pnpm --filter @dobedan/company build",
    "build:portal": "pnpm --filter @dobedan/portal build",
    "lint": "pnpm -r --filter \"./apps/**\" lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:brand": "node ../scripts/check-brand.mjs",
    "gorsel-kontrol": "pnpm --dir ../scripts/gorsel-kontrol start"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "react-imask": "^7.6.1",
    "recharts": "^3.6.0"
  }
}
