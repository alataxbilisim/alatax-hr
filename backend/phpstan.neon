includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - app/
    tmpDir: storage/framework/cache/phpstan
    # PostgreSQL dump'ı Larastan'ın MySQL ayrıştırıcısında okunmuyor; scripts/larastan-schema.php üretir.
    squashedMigrationsPath:
        - storage/framework/cache/phpstan-schema
