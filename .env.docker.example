# ALATAX HR — Docker Compose ortam değişkenleri (ÖRNEK)
# Kopyala:  cp .env.docker.example .env
# Bu dosya compose + container env için. Gerçek secret koyma; sadece local örnek değerler.
# Tek kaynak kökteki .env dosyasıdır; backend/.env kullanılmaz. Compose, container
# environment ile DB_HOST/REDIS_HOST vb. değerleri verir (Laravel Dotenv immutable).

# --- Uygulama ---
APP_NAME="ALATAX HR"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_HTTP_PORT=8000

# Locale / TZ (TR) — container env, backend/.env üzerine yazar
APP_TIMEZONE=Europe/Istanbul
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

# Frontend SPA URLs (password reset / invitation email links)
FRONTEND_URL_COMPANY=http://localhost:3002
FRONTEND_URL_PORTAL=http://localhost:3003
FRONTEND_URL_SUPERADMIN=http://localhost:3001
FRONTEND_URL=http://localhost:3002

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# CORS — virgülle ayrılmış SPA origin listesi (IP hardcode yok)
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002,http://localhost:3003,http://127.0.0.1:3003

# --- Veritabanı (yalnız PostgreSQL 16) ---
DB_CONNECTION=pgsql
DB_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_DB=alatax_hr
POSTGRES_USER=alatax
POSTGRES_PASSWORD=secret

# --- Redis (cache + queue + session) ---
REDIS_CLIENT=phpredis
REDIS_HOST_PORT=6379
REDIS_PASSWORD=null
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# --- Mail (dev: log | Mailtrap için smtp + kendi USERNAME/PASSWORD) ---
# MAIL_MAILER=smtp
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=
# MAIL_PASSWORD=
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@alatax.local"
MAIL_FROM_NAME="${APP_NAME}"
